<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="org.codebangladesh.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_coursesFragment"
            app:destination="@id/coursesFragment" />
    </fragment>

    <fragment
        android:id="@+id/coursesFragment"
        android:name="org.codebangladesh.ui.courses.CoursesFragment"
        tools:layout="@layout/fragment_courses">
        <argument
            android:name="categoryName"
            app:argType="string" />
        <action
            android:id="@+id/action_coursesFragment_to_courseVideosFragment"
            app:destination="@id/courseVideosFragment" />
    </fragment>

    <fragment
        android:id="@+id/courseVideosFragment"
        android:name="org.codebangladesh.ui.videos.CourseVideosFragment"
        tools:layout="@layout/fragment_course_videos">
        <argument
            android:name="categoryName"
            app:argType="string" />
        <argument
            android:name="courseName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="org.codebangladesh.ui.settings.SettingsFragment"
        tools:layout="@layout/fragment_settings" />

</navigation>